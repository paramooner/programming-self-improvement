## ============ 公共基础样式 ============
## 字体：中文黑体，西文 Times New Roman
font.family: sans-serif
font.sans-serif: SimHei, Times New Roman, Arial
axes.unicode_minus: False

## 线条与标记
lines.linewidth: 2.0
lines.markersize: 6
lines.markeredgewidth: 1.0

## 坐标轴与文字字号
axes.linewidth: 1.0
axes.labelsize: 11
axes.titlesize: 13
axes.titleweight: bold
xtick.labelsize: 10
ytick.labelsize: 10
xtick.major.width: 1.0
ytick.major.width: 1.0

## 图例：无边框，不遮数据（位置在代码里按需指定）
legend.fontsize: 10
legend.frameon: False
legend.handlelength: 2.0

## 颜色循环：由 theme.use_theme() 统一设置（style 文件中的 # 会被当作注释）

## 输出
figure.dpi: 100
savefig.dpi: 300
savefig.bbox: tight
savefig.facecolor: white

## ============ 期刊风（journal）专属 ============
## 刻度向内、四边刻度、虚线网格、保留外框
xtick.direction: in
ytick.direction: in
xtick.top: True
ytick.right: True
axes.grid: True
grid.linestyle: --
grid.color: "#999999"
grid.alpha: 0.3
grid.linewidth: 0.6
